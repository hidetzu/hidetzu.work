---
// /math 共通のメニューの中身。PC の左のメニュー（MathNav）と、狭い画面のヘッダーの「メニュー」（MathHeader）の 2 か所で使う。
// 上から、すべてのノート、分野（基礎から応用の順。開いている分野だけ、ノートを分野の中の順に展開する）、
// 参照資料（記号と文字、学習記録、参考文献から探す）。site を付けると、最後にサイトへの戻りを足す
import { getMathNotes, groupByField, groupByReference } from '../lib/math-notes';

export type MathNavCurrent = {
  // 開いているページ。note は個別ノート、field は分野別一覧
  page: 'top' | 'all' | 'field' | 'note' | 'notation' | 'learning' | 'search';
  // 分野別一覧の分野、またはノートの分野（src/data/math.json の fields の id）
  field?: string;
  // 開いているノートの slug
  note?: string;
};

interface Props {
  current: MathNavCurrent;
  site?: boolean;
}

const { current, site = false } = Astro.props;
const notes = await getMathNotes();
const fields = groupByField(notes);
const references = groupByReference(notes).references;

// 開いているページの項目は aria-current="page"。ノートを開いているときは、その分野を aria-current="true" にする
const pageCurrent = (page: MathNavCurrent['page']) => (current.page === page ? 'page' : undefined);
const fieldCurrent = (id: string) =>
  current.field !== id ? undefined : current.page === 'field' ? 'page' : 'true';
const noteCurrent = (id: string) => (current.note === id ? 'page' : undefined);
---

<ul class="math-nav-list">
  <li>
    <a href="/math/notes" aria-current={pageCurrent('all')}>
      <span>すべてのノート</span>
      <span class="math-nav-count">{notes.length}<span class="visually-hidden"> ノート</span></span>
    </a>
  </li>
</ul>

<p class="math-nav-head">分野</p>
<ul class="math-nav-list">
  {
    fields.map(({ field, notes }) => (
      <li>
        <a href={`/math/fields/${field.id}`} aria-current={fieldCurrent(field.id)}>
          <span>{field.title}</span>
          <span class="math-nav-count">
            {notes.length}
            <span class="visually-hidden"> ノート</span>
          </span>
        </a>
        {current.field === field.id && (
          <ol class="math-nav-notes">
            {notes.map((note) => (
              <li>
                <a href={`/math/${note.id}`} aria-current={noteCurrent(note.id)}>
                  {note.data.title}
                </a>
              </li>
            ))}
          </ol>
        )}
      </li>
    ))
  }
</ul>

<p class="math-nav-head">参照資料</p>
<ul class="math-nav-list">
  <li><a href="/math/notation" aria-current={pageCurrent('notation')}>数学の記号と文字</a></li>
  <li><a href="/math/learning" aria-current={pageCurrent('learning')}>学習記録</a></li>
  <li>
    {/* 初期状態では閉じておく。参考文献の章・節から、対応するノートを開く（学習記録の textbook を使う） */}
    <details class="math-nav-refs">
      <summary>参考文献から探す</summary>
      {
        references.map(({ reference, chapters }) => (
          <div class="math-nav-ref">
            <p class="math-nav-ref-title" lang="en">{reference.title}</p>
            {chapters.map(({ chapter, sections, unsectioned }) => (
              <div class="math-nav-chapter">
                <p class="math-nav-chapter-title">
                  Chapter {chapter.number} <span lang="en">{chapter.title}</span>
                </p>
                <ul>
                  {/* 節を記録していないノート（章のどこかを読んだもの）を先に、節ごとのノートを節の順に */}
                  {unsectioned.map((note) => (
                    <li>
                      <a href={`/math/${note.id}`} aria-current={noteCurrent(note.id)}>
                        <span class="math-nav-section">Ch.{chapter.number}</span>
                        {note.data.title}
                      </a>
                    </li>
                  ))}
                  {sections.map(({ section, notes }) =>
                    notes.map((note) => (
                      <li>
                        <a href={`/math/${note.id}`} aria-current={noteCurrent(note.id)}>
                          <span class="math-nav-section">§{section.number}</span>
                          {note.data.title}
                        </a>
                      </li>
                    )),
                  )}
                </ul>
              </div>
            ))}
          </div>
        ))
      }
    </details>
  </li>
</ul>

{
  site && (
    <>
      <p class="math-nav-head">サイト</p>
      <ul class="math-nav-list">
        <li><a href="/">Home</a></li>
        <li><a href="/ml">Machine Learning</a></li>
      </ul>
    </>
  )
}
