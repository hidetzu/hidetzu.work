---
// プロジェクトごとのモチーフ。装飾なので支援技術からは隠す。
import type { Motif } from '../data/types';

interface Props {
  name: Motif;
}
const { name } = Astro.props;
---

<svg class="motif" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  {
    name === 'map' && (
      <>
        <path d="M3 9.5 L12 6.5 L20 9.5 L29 6.5 L29 22.5 L20 25.5 L12 22.5 L3 25.5 Z" />
        <path d="M12 6.5 V22.5" />
        <path d="M20 9.5 V25.5" />
        <circle class="motif-mark" cx="16" cy="15" r="2" />
      </>
    )
  }
  {
    name === 'loop' && (
      <>
        <circle class="motif-dash" cx="16" cy="16" r="10" />
        <path
          class="motif-mark"
          d="M-2.8,-2.4 L2.6,0 L-2.8,2.4 Z"
          transform="translate(18.8 6.4) rotate(16.5)"
        />
      </>
    )
  }
  {
    name === 'packet' && (
      <>
        <rect x="2" y="10.5" width="21" height="11" rx="1.5" />
        <path d="M7.5 10.5 V21.5" />
        <path d="M12 10.5 V21.5" />
        <path d="M25 16 H27.5" />
        <path class="motif-mark" d="M27.5 13.6 L30.5 16 L27.5 18.4 Z" />
      </>
    )
  }
  {
    name === 'gate' && (
      <>
        <path d="M3 16 H13" />
        <path d="M19 16 H29" />
        <path d="M13 7 V25" />
        <path d="M19 7 V25" />
        <circle class="motif-mark" cx="16" cy="16" r="2" />
      </>
    )
  }
  {
    name === 'layers' && (
      <>
        <path d="M4 7.5 H28" />
        <path d="M4 13.5 H28" />
        <path d="M4 19.5 H28" />
        <path d="M4 25.5 H28" />
        <circle class="motif-mark" cx="16" cy="19.5" r="2" />
      </>
    )
  }
  {
    name === 'flag' && (
      <>
        <path d="M9 4 V28" />
        <path d="M9 6 H25 L21 11 L25 16 H9" />
        <circle class="motif-mark" cx="9" cy="28" r="2" />
      </>
    )
  }
  {
    name === 'frames' && (
      <>
        <rect x="3" y="9" width="16" height="12" rx="1.5" />
        <path d="M8 6 H24 V18" />
        <path d="M13 3 H29 V15" />
        <rect class="motif-mark" x="9" y="13" width="4" height="4" rx="0.5" />
      </>
    )
  }
  {
    name === 'graph' && (
      <>
        <path d="M8 8 L16 16 L24 9" />
        <path d="M16 16 L10 25" />
        <path class="motif-dotted" d="M16 16 L25 24" />
        <circle cx="8" cy="8" r="2.5" />
        <circle cx="24" cy="9" r="2.5" />
        <circle cx="10" cy="25" r="2.5" />
        <circle cx="25" cy="24" r="2.5" />
        <circle class="motif-mark" cx="16" cy="16" r="2.5" />
      </>
    )
  }
  {
    name === 'scan' && (
      <>
        <rect x="5" y="4" width="22" height="24" rx="1.5" />
        <path d="M10 11 H22" />
        <path d="M10 16 H22" />
        <path d="M10 21 H16" />
        <circle class="motif-mark" cx="21" cy="21" r="2" />
      </>
    )
  }
  {
    name === 'note' && (
      <>
        <path d="M7 4 H21 L25 8 V28 H7 Z" />
        <path d="M11 13 H21" />
        <path d="M11 18 H21" />
        <path d="M11 23 H17" />
        <circle class="motif-mark" cx="21" cy="4.5" r="2" />
      </>
    )
  }
  {
    name === 'sieve' && (
      <>
        <path d="M4 7 H28 L19 18 V27 L13 24 V18 Z" />
        <circle cx="10" cy="3" r="1" />
        <circle cx="16" cy="3" r="1" />
        <circle cx="22" cy="3" r="1" />
        <circle class="motif-mark" cx="16" cy="29.5" r="1.8" />
      </>
    )
  }
</svg>
