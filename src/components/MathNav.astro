---
// /math 共通の左のメニュー（PC、64rem 以上）。狭い画面では出さず、ヘッダーの「メニュー」（MathHeader）で同じ中身を開く。
// ノートの中の目次（NoteLayout）とは別のもので、こちらは Math Notes 全体の目次
import MathNavList, { type MathNavCurrent } from './MathNavList.astro';

export type { MathNavCurrent };

interface Props {
  current: MathNavCurrent;
}

const { current } = Astro.props;
---

<aside class="math-nav-side">
  <nav aria-label="Math Notes の目次">
    <MathNavList current={current} />
  </nav>
</aside>
