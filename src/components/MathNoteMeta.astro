---
// 数学ノートの本文の後の「参考文献」に置く表（日付・参考文献・タグ・学習記録へのリンク）。
// 状態の説明と参考文献の範囲（Study log）は学習記録（/math/learning）に出す（docs/adr/0009）
import { learningHref, ymd, type MathNote } from '../lib/math-notes';

interface Props {
  note: MathNote;
}

const { note } = Astro.props;
const { createdAt, updatedAt, tags, sources } = note.data;
---

<dl class="math-meta">
  <div>
    <dt>Created</dt>
    <dd><time datetime={ymd(createdAt)}>{ymd(createdAt)}</time></dd>
  </div>
  {
    updatedAt && (
      <div>
        <dt>Updated</dt>
        <dd><time datetime={ymd(updatedAt)}>{ymd(updatedAt)}</time></dd>
      </div>
    )
  }
  {
    sources.length > 0 && (
      <div>
        <dt>Sources</dt>
        <dd>
          <ul class="math-sources">
            {sources.map((src) => (
              <li>
                <span lang="en">{src.title}</span>
                {src.location && <span class="release">{src.location}</span>}
                {src.note && <span class="math-source-note">{src.note}</span>}
              </li>
            ))}
          </ul>
        </dd>
      </div>
    )
  }
  {
    tags.length > 0 && (
      <div>
        <dt>Tags</dt>
        <dd>{tags.join(' / ')}</dd>
      </div>
    )
  }
  <div>
    <dt>Learning</dt>
    <dd>
      <a href={learningHref(note.id)}>学習記録</a>（状態、参考文献の範囲、証明の出どころ、学習の経過）
    </dd>
  </div>
</dl>
