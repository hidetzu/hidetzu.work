---
// ノートの目次。NoteLayout が PC のサイドバーとモバイルの折りたたみの 2 か所で使う。
// 2 段目（###）は 1 段目（##）の下にまとめる。見出しに番号があるので、リストの番号は付けない
export type TocItem = { text: string; slug: string; children: { text: string; slug: string }[] };

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
---

<ul class="note-toc-list">
  {
    items.map((h) => (
      <li>
        <a href={`#${h.slug}`}>{h.text}</a>
        {h.children.length > 0 && (
          <ul>
            {h.children.map((c) => (
              <li>
                <a href={`#${c.slug}`}>{c.text}</a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ul>
