---
import { render } from 'astro:content';
// KaTeX の CSS は数学ノートの記事ページにだけ入れる（フォントは数式で使う字形だけが読み込まれる）
import 'katex/dist/katex.min.css';
import Base from '../../layouts/Base.astro';
import '../../styles/math.css';
import { getMathNotes, mathStatusLabel, mathStatusNote, ymd, type MathNote } from '../../lib/math-notes';

export async function getStaticPaths() {
  const notes = await getMathNotes();
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

interface Props {
  note: MathNote;
}

const { note } = Astro.props;
const { Content, headings } = await render(note);
const { title, description, topic, status, createdAt, updatedAt, tags, sources, draft } = note.data;
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={title} description={description} ogType="article">
  <main id="main" class="math-note">
    <p class="math-back"><a href="/math">← Math Notes</a></p>
    <header class="math-head">
      <span class="topic">{topic}</span>
      <h1>{title}</h1>
      <p class="math-description">{description}</p>
      <dl class="math-meta">
        <div>
          <dt>Status</dt>
          <dd>
            <span class="status">{mathStatusLabel[status]}</span>
            {draft && <span class="status">draft</span>}
            {mathStatusNote[status]}（自己申告）
          </dd>
        </div>
        <div>
          <dt>Created</dt>
          <dd><time datetime={ymd(createdAt)}>{ymd(createdAt)}</time></dd>
        </div>
        {
          updatedAt && (
            <div>
              <dt>Updated</dt>
              <dd><time datetime={ymd(updatedAt)}>{ymd(updatedAt)}</time></dd>
            </div>
          )
        }
        {
          sources.length > 0 && (
            <div>
              <dt>Sources</dt>
              <dd>
                <ul class="math-sources">
                  {sources.map((src) => (
                    <li>
                      <span lang="en">{src.title}</span>
                      {src.location && <span class="release">{src.location}</span>}
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
        {
          tags.length > 0 && (
            <div>
              <dt>Tags</dt>
              <dd>{tags.join(' / ')}</dd>
            </div>
          )
        }
      </dl>
    </header>

    {
      toc.length > 1 && (
        <nav class="math-toc" aria-label="目次">
          <ol>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <article class="prose">
      <Content />
    </article>

    <p class="math-back math-back--end"><a href="/math">← Math Notes に戻る</a></p>
  </main>
</Base>
