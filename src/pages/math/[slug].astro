---
import { getCollection, render } from 'astro:content';
// KaTeX の CSS は数学ノートの記事ページにだけ入れる（フォントは数式で使う字形だけが読み込まれる）
import 'katex/dist/katex.min.css';
import NoteLayout from '../../layouts/NoteLayout.astro';
import MathNoteMeta from '../../components/MathNoteMeta.astro';
import MathNoteLinks from '../../components/MathNoteLinks.astro';
import MathNav from '../../components/MathNav.astro';
import type { TocItem } from '../../components/NoteToc.astro';
import '../../styles/math.css';
import {
  fieldOf,
  getMathGraph,
  getMathNotes,
  learningHref,
  mathStatusLabel,
  mathStatusNote,
  relatedNotes,
  ymd,
  type MathNote,
} from '../../lib/math-notes';

export async function getStaticPaths() {
  const notes = await getMathNotes();
  const all = await getCollection('math');
  // /math の下で別のページに使っている名前は、ノートの slug にできない
  const reserved = ['search', 'learning', 'notation', 'notes', 'fields'];
  for (const n of all) {
    if (reserved.includes(n.id)) throw new Error(`math: slug "${n.id}" is reserved for another page`);
  }
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note, notes, related: relatedNotes(note, notes, all) },
  }));
}

interface Props {
  note: MathNote;
  notes: MathNote[];
  related: MathNote[];
}

const { note, notes, related } = Astro.props;
const { Content, headings } = await render(note);
const { title, description, aliases, status, createdAt, updatedAt, sources, draft } = note.data;
const field = fieldOf(note);

// 目次: 2 段目（###）は 1 段目（##）の下にまとめる
const toc: TocItem[] = [];
for (const h of headings) {
  if (h.depth === 2) toc.push({ text: h.text, slug: h.slug, children: [] });
  else if (h.depth === 3 && toc.length > 0) toc[toc.length - 1].children.push({ text: h.text, slug: h.slug });
}

// 本文の後の「証明の依存関係」があるか（目次に足す）
const graph = await getMathGraph();
const statementsHere = (graph.statementsByNote.get(note.id) ?? []).filter((s) => s.key && s.uses.size > 0);

// 目次: 本文の見出しのあとに、本文の後の節を足す
const noteToc: TocItem[] = [
  ...toc,
  ...(statementsHere.length > 0 ? [{ text: '証明の依存関係', slug: 'math-deps', children: [] }] : []),
  { text: '参考文献', slug: 'note-about', children: [] },
];
---

<NoteLayout
  title={title}
  description={description}
  aliases={aliases}
  area="math"
  filters={{ field: field.id }}
  back={{ href: '/math', label: 'Math Notes' }}
  category={{ href: `/math/fields/${field.id}`, label: field.title }}
  toc={noteToc}
>
  <MathNav slot="nav" current={{ page: 'note', field: field.id, note: note.id }} />
  <Fragment slot="meta">
    <a class="status" href={learningHref(note.id)} title={mathStatusNote[status]}>
      {mathStatusLabel[status]}
    </a>
    {draft && <span class="status">draft</span>}
    <span>
      {updatedAt ? '更新' : '作成'}{' '}
      <time datetime={ymd(updatedAt ?? createdAt)}>{ymd(updatedAt ?? createdAt)}</time>
    </span>
    {sources.length > 0 && <a href="#note-about">参考文献 {sources.length}</a>}
    <a href={learningHref(note.id)}>学習記録</a>
  </Fragment>
  <Content />
  <Fragment slot="after">
    <MathNoteLinks note={note} notes={notes} related={related} />
    <section class="note-about" aria-labelledby="note-about">
      <h2 class="sub-head" id="note-about">参考文献</h2>
      <MathNoteMeta note={note} />
    </section>
  </Fragment>
</NoteLayout>
