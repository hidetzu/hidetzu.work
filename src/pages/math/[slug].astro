---
import { getCollection, render } from 'astro:content';
// KaTeX の CSS は数学ノートの記事ページにだけ入れる（フォントは数式で使う字形だけが読み込まれる）
import 'katex/dist/katex.min.css';
import Base from '../../layouts/Base.astro';
import '../../styles/math.css';
import { richText } from '../../lib/tex';
import {
  fieldOf,
  getMathGraph,
  getMathNotes,
  mathStatusLabel,
  mathStatusNote,
  relatedNotes,
  statementHref,
  textbookLabel,
  ymd,
  type MathNote,
} from '../../lib/math-notes';

export async function getStaticPaths() {
  const notes = await getMathNotes();
  const all = await getCollection('math');
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note, notes, related: relatedNotes(note, notes, all) },
  }));
}

interface Props {
  note: MathNote;
  notes: MathNote[];
  related: MathNote[];
}

const { note, notes, related } = Astro.props;
const { Content, headings } = await render(note);
const { title, description, status, createdAt, updatedAt, tags, sources, draft } = note.data;
const field = fieldOf(note);
const chapter = textbookLabel(note);

// 目次: 2 段目（###）は 1 段目（##）の下にまとめる
const toc: { text: string; slug: string; children: { text: string; slug: string }[] }[] = [];
for (const h of headings) {
  if (h.depth === 2) toc.push({ text: h.text, slug: h.slug, children: [] });
  else if (h.depth === 3 && toc.length > 0) toc[toc.length - 1].children.push({ text: h.text, slug: h.slug });
}

// 証明の依存関係（証明の中のリンクから集めたもの）
const graph = await getMathGraph();
const titleOf = (slug: string) => notes.find((n) => n.id === slug)?.data.title ?? slug;
const statementTitle = (key: string) => graph.statements.get(key)?.title ?? key;
const statementsHere = (graph.statementsByNote.get(note.id) ?? []).filter(
  (s) => s.key && (s.uses.size > 0 || s.usedBy.size > 0),
);
const byId = (slugs: Set<string> | undefined) =>
  notes.filter((n) => slugs?.has(n.id));
const prerequisites = byId(graph.noteUses.get(note.id));
const dependents = byId(graph.noteUsedBy.get(note.id));
---

<Base title={title} description={description} ogType="article">
  <main id="main" class="math-note">
    <p class="math-back"><a href="/math">← Math Notes</a></p>
    <header class="math-head">
      <a class="topic math-field-link" href={`/math#${field.id}`}>{field.title}</a>
      <h1>{title}</h1>
      <p class="math-description">{description}</p>
      <dl class="math-meta">
        <div>
          <dt>Status</dt>
          <dd>
            <span class="status">{mathStatusLabel[status]}</span>
            {draft && <span class="status">draft</span>}
            {mathStatusNote[status]}（ページ全体の自己申告。証明ごとの出どころは各証明に書く）
          </dd>
        </div>
        {
          chapter && (
            <div>
              <dt>Textbook</dt>
              <dd>
                <a href="/math#textbook" lang="en">{chapter}</a>
              </dd>
            </div>
          )
        }
        <div>
          <dt>Created</dt>
          <dd><time datetime={ymd(createdAt)}>{ymd(createdAt)}</time></dd>
        </div>
        {
          updatedAt && (
            <div>
              <dt>Updated</dt>
              <dd><time datetime={ymd(updatedAt)}>{ymd(updatedAt)}</time></dd>
            </div>
          )
        }
        {
          sources.length > 0 && (
            <div>
              <dt>Sources</dt>
              <dd>
                <ul class="math-sources">
                  {sources.map((src) => (
                    <li>
                      <span lang="en">{src.title}</span>
                      {src.location && <span class="release">{src.location}</span>}
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
        {
          tags.length > 0 && (
            <div>
              <dt>Tags</dt>
              <dd>{tags.join(' / ')}</dd>
            </div>
          )
        }
      </dl>
    </header>

    {
      toc.length > 1 && (
        <nav class="math-toc" aria-labelledby="math-toc-title">
          <p class="math-toc-title" id="math-toc-title">目次</p>
          <ul>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
                {h.children.length > 0 && (
                  <ul>
                    {h.children.map((c) => (
                      <li>
                        <a href={`#${c.slug}`}>{c.text}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
            {statementsHere.length > 0 && (
              <li>
                <a href="#math-deps">証明の依存関係</a>
              </li>
            )}
          </ul>
        </nav>
      )
    }

    <article class="prose">
      <Content />
    </article>

    {
      statementsHere.length > 0 && (
        <section class="math-deps" aria-labelledby="math-deps">
          <h2 class="sub-head" id="math-deps">証明の依存関係</h2>
          <p class="math-deps-lead">
            各証明の中で参照している定義・定理と、その結果を参照している証明の一覧。証明の外にある関連リンクは含めない。
          </p>
          <dl class="math-deps-list">
            {statementsHere.map((s) => (
              <div>
                <dt>
                  <a href={`#${s.id}`} set:html={richText(s.title)} />
                </dt>
                {s.uses.size > 0 && (
                  <dd>
                    <span class="math-deps-kind">証明で使う</span>
                    <ul>
                      {[...s.uses].map((key) => (
                        <li>
                          <a href={statementHref(key, note.id)} set:html={richText(statementTitle(key))} />
                          {!key.startsWith(`${note.id}#`) && (
                            <span class="math-deps-note">（{titleOf(key.split('#')[0])}）</span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </dd>
                )}
                {s.usedBy.size > 0 && (
                  <dd>
                    <span class="math-deps-kind">この結果を使う証明</span>
                    <ul>
                      {[...s.usedBy].map((key) => (
                        <li>
                          <a href={statementHref(key, note.id)} set:html={richText(statementTitle(key))} />
                          {!key.startsWith(`${note.id}#`) && (
                            <span class="math-deps-note">（{titleOf(key.split('#')[0])}）</span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </dd>
                )}
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      (prerequisites.length > 0 || dependents.length > 0) && (
        <nav class="math-note-links" aria-labelledby="math-note-links">
          <h2 class="sub-head" id="math-note-links">Dependencies</h2>
          <dl>
            {prerequisites.length > 0 && (
              <div>
                <dt>証明で使うノート</dt>
                <dd>
                  <ul>
                    {prerequisites.map((n) => (
                      <li>
                        <a href={`/math/${n.id}`}>{n.data.title}</a>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            )}
            {dependents.length > 0 && (
              <div>
                <dt>このノートの結果を使うノート</dt>
                <dd>
                  <ul>
                    {dependents.map((n) => (
                      <li>
                        <a href={`/math/${n.id}`}>{n.data.title}</a>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            )}
          </dl>
        </nav>
      )
    }

    {
      related.length > 0 && (
        <nav class="math-related" aria-labelledby="math-related">
          <h2 class="sub-head" id="math-related">Related</h2>
          <p class="math-deps-lead">内容が関連するノート。証明で使っているとは限らない。</p>
          <ul class="others math-list">
            {related.map((n) => (
              <li>
                <span class="topic">{fieldOf(n).title}</span>
                <p class="other-name">
                  <a href={`/math/${n.id}`}>
                    <strong>{n.data.title}</strong>
                  </a>
                </p>
                <p class="other-summary">{n.data.description}</p>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <p class="math-back math-back--end"><a href="/math">← Math Notes に戻る</a></p>
  </main>
</Base>
