---
import MathLayout from '../../layouts/MathLayout.astro';
import mathData from '../../data/math.json';
import type { MathIndex } from '../../data/types';
import { fieldOf, getMathNotes, groupByField, lastModified, mathStatusLabel, ymd } from '../../lib/math-notes';

const data = mathData as MathIndex;
const notes = await getMathNotes();
// 分野ごとに、分野の中の順（order）で並べる。ノートのない分野は出さない
const groups = groupByField(notes);

const description = '数学を基礎から学び直しながら、定義・定理・証明・具体例・反例を自分の言葉で整理していく個人の数学ノート。';

// このページの役割は「ノートを探す入口」（docs/design/content-platform.md §4.1）。
// 順に、説明と検索、分野（カード）、最近の更新、学習記録への導線。
// ノート間の依存関係の一覧は /math/learning#dependencies に、詳しい方針は /math/learning#about にある
// 最近更新したノート（タイトル・分野・日付だけ。説明は分野のカードとノートで読む）
const recent = [...notes].sort((a, b) => lastModified(b).getTime() - lastModified(a).getTime()).slice(0, 5);
---

<MathLayout title="Math Notes" description={description} current={{ page: 'top' }}>
  <main id="main" class="math-index">
    <section class="section" aria-labelledby="math-notes">
      <div class="section-head">
        <span class="num">∑</span>
        <h1 id="math-notes">Math Notes</h1>
      </div>
      {data.lead.map((p) => <p class="lede">{p}</p>)}
      {/* JS を使わず /math/search へ送るだけのフォーム（検索そのものは検索ページで行う。docs/adr/0010） */}
      <form class="math-search-form" action="/math/search" method="get" role="search">
        <label for="math-index-q" class="visually-hidden">数学ノートを検索</label>
        <input id="math-index-q" type="search" name="q" placeholder="数学ノートを検索" />
        <button type="submit">検索</button>
      </form>
      <p class="math-index-links">
        <a href="/math/learning#about">このノートについて</a>
        <a href="/math/notation">数学の記号と文字</a>
        <a href="/math/learning">学習記録</a>
      </p>
    </section>

    {
      notes.length === 0 ? (
        <section class="section">
          <p class="math-empty">まだ公開しているノートはありません。</p>
        </section>
      ) : (
        <>
          <section class="section" aria-labelledby="fields">
            <h2 class="sub-head" id="fields">Fields</h2>
            {/* 分野ごとのカード。分野の中は、おおむね前提となる概念から順に並べている（order） */}
            <ul class="math-field-cards">
              {groups.map(({ field, notes }) => (
                <li class="math-field-card" id={field.id}>
                  <h3>
                    <a href={`/math/fields/${field.id}`}>{field.title}</a>
                    <span class="math-field-count">{notes.length} ノート</span>
                  </h3>
                  <p class="math-field-description">{field.description}</p>
                  <ul class="math-field-notes">
                    {notes.map((note) => (
                      <li>
                        <a href={`/math/${note.id}`} title={note.data.description}>
                          {note.data.title}
                        </a>
                        {note.data.status !== 'understood' && (
                          <span class="math-field-status">{mathStatusLabel[note.data.status]}</span>
                        )}
                        {note.data.draft && <span class="math-field-status">draft</span>}
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
          </section>

          <section class="section" aria-labelledby="recent">
            <h2 class="sub-head" id="recent">Recently Updated</h2>
            <ul class="math-recent">
              {recent.map((n) => (
                <li>
                  <time datetime={ymd(lastModified(n))}>{ymd(lastModified(n))}</time>
                  <a href={`/math/${n.id}`}>{n.data.title}</a>
                  <span class="math-recent-field">{fieldOf(n).title}</span>
                </li>
              ))}
            </ul>
          </section>

          <section class="section" aria-labelledby="learning">
            <h2 class="sub-head" id="learning">Learning Log</h2>
            {/* 旧アンカー（学習記録・依存関係を /math/learning に移す前の節）。外からのリンクが切れないように残す */}
            <span id="now"></span>
            <span id="references"></span>
            <span id="textbook"></span>
            <span id="legend"></span>
            <span id="roadmap"></span>
            <span id="dependencies"></span>
            <p class="math-section-lead">
              ノートの状態、参考文献ごとの学習範囲、証明の出どころ、ノート間の依存関係、これから学ぶ予定は
              <a href="/math/learning">学習記録</a>にまとめている。
            </p>
          </section>
        </>
      )
    }
  </main>
</MathLayout>
