---
// 機械学習の学習ノート（/ml/<slug>）。src/content/ml/<slug>.md から作る。
// 書き方は docs/ml-note-template.md。数式・ブロックは数学ノートと同じ Markdown の仕組みを使う
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from '../../layouts/Base.astro';
import '../../styles/math.css';
import '../../styles/ml.css';
import { areaOf, getMlNotes, mlStatusLabel, mlStatusNote, ymd, type MlNote } from '../../lib/ml';

export async function getStaticPaths() {
  const notes = await getMlNotes();
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

interface Props {
  note: MlNote;
}

const { note } = Astro.props;
const { Content, headings } = await render(note);
const { title, description, status, progress, createdAt, updatedAt, tags, references, draft } = note.data;
const area = areaOf(note);
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={title} description={description} ogType="article">
  <main id="main" class="math-note ml-note">
    <p class="math-back"><a href="/ml">← Machine Learning</a></p>
    <header class="math-head">
      <a class="topic math-field-link" href={`/ml#area-${area.id}`}>{area.number} {area.title}</a>
      <h1>{title}</h1>
      <p class="math-description">{description}</p>
      <dl class="math-meta">
        <div>
          <dt>Status</dt>
          <dd>
            <span class={`status ml-status ml-status--${status}`}>{mlStatusLabel[status]}</span>
            {draft && <span class="status">draft</span>}
            {progress ? `${progress}（自己申告）` : `${mlStatusNote[status]}（自己申告）`}
          </dd>
        </div>
        <div>
          <dt>Created</dt>
          <dd><time datetime={ymd(createdAt)}>{ymd(createdAt)}</time></dd>
        </div>
        {
          updatedAt && (
            <div>
              <dt>Updated</dt>
              <dd><time datetime={ymd(updatedAt)}>{ymd(updatedAt)}</time></dd>
            </div>
          )
        }
        {
          tags.length > 0 && (
            <div>
              <dt>Tags</dt>
              <dd>{tags.join(' / ')}</dd>
            </div>
          )
        }
      </dl>
    </header>

    {
      toc.length > 1 && (
        <nav class="math-toc" aria-labelledby="math-toc-title">
          <p class="math-toc-title" id="math-toc-title">目次</p>
          <ul>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
            {references.length > 0 && (
              <li>
                <a href="#ml-references">参考文献・原論文</a>
              </li>
            )}
          </ul>
        </nav>
      )
    }

    <article class="prose">
      <Content />
    </article>

    {
      references.length > 0 && (
        <section class="math-related" aria-labelledby="ml-references">
          <h2 class="sub-head" id="ml-references">参考文献・原論文</h2>
          <ul class="math-sources">
            {references.map((r) => (
              <li>
                {r.url ? (
                  <a href={r.url} rel="noopener" lang="en">
                    {r.title}
                  </a>
                ) : (
                  <span lang="en">{r.title}</span>
                )}
                {r.year && <span class="release">{r.year}</span>}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="math-back math-back--end"><a href="/ml">← Machine Learning に戻る</a></p>
  </main>
</Base>
