---
import Base from '../layouts/Base.astro';
import LoopDiagram from '../components/LoopDiagram.astro';
import Motif from '../components/Motif.astro';
import siteData from '../data/site.json';
import nowData from '../data/now.json';
import projectsData from '../data/projects.json';
import writingData from '../data/writing.json';
import aboutData from '../data/about.json';
import type { Site, Now, Project, Status, Writing, About } from '../data/types';

const site = siteData as Site;
const now = nowData as Now;
const projects = projectsData as Project[];
const writing = writingData as Writing;
const about = aboutData as About;

const selected = projects.filter((p) => p.placement === 'selected');
const experiments = projects.filter((p) => p.placement === 'experiment');
const others = projects.filter((p) => p.placement === 'more');

// questions / writing から id でプロジェクトを引く。存在しない id はビルドで落とす
const byId = new Map(projects.map((p) => [p.id, p]));
const project = (id: string) => {
  const p = byId.get(id);
  if (!p) throw new Error(`unknown project id: ${id}`);
  return p;
};
const anchor = (id: string) => `p-${id}`;

const statusLabel: Record<Status, string> = {
  released: 'Released',
  development: 'Development',
  experimental: 'Experimental',
  reference: 'Reference',
};

// タイルの小さな補足。https://github.com/hidetzu → github.com/hidetzu
const handle = (url: string) => {
  const u = new URL(url);
  return `${u.host}${u.pathname}`.replace(/\/$/, '');
};
---

<Base>
  <section class="hero" aria-label="Introduction">
    <div class="hero-figure">
      <LoopDiagram />
    </div>
    <div class="lane" aria-hidden="true"><i></i>hidetzu.work<i></i></div>
    <h1>{site.name}</h1>
    <p class="tagline" lang="en">{site.tagline}</p>
    <p class="hero-lede">{site.lede}</p>
    <nav class="tiles" aria-label="profiles">
      {
        site.links.map((link, i) => (
          <a class:list={['tile', { primary: i === 0 }]} href={link.url} rel="me noopener">
            {link.label}
            <small>{handle(link.url)}</small>
          </a>
        ))
      }
    </nav>
    <a class="scroll-cue" href="#main">Current Questions ↓</a>
  </section>

  <main id="main">
    <section class="section" aria-labelledby="questions">
      <div class="section-head">
        <span class="num">01</span>
        <h2 id="questions">Current Questions</h2>
      </div>
      <div class="section-body">
        <p class="lede">{now.lead}</p>
        <ol class="questions">
          {
            now.questions.map((q, i) => (
              <li class="question">
                <span class="question-index" aria-hidden="true">
                  Q{i + 1}
                </span>
                <div class="question-body">
                  <span class="topic">{q.name}</span>
                  <p class="question-text">{q.question}</p>
                  <p class="question-note">{q.note}</p>
                  <p class="question-projects">
                    <span class="visually-hidden">関連するプロジェクト:</span>
                    <span aria-hidden="true">→</span>
                    {q.projects.map((id) => (
                      <a href={`#${anchor(id)}`}>{project(id).name}</a>
                    ))}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section" aria-labelledby="work">
      <div class="section-head">
        <span class="num">02</span>
        <h2 id="work">Selected Work</h2>
      </div>
      <div class="section-body">
        <dl class="legend">
          <div><dt>Released</dt><dd>GitHub Release で配布物を出している</dd></div>
          <div><dt>Development</dt><dd>動く実装はあるが開発途上</dd></div>
          <div><dt>Experimental</dt><dd>技術的な問いの検証が中心</dd></div>
          <div><dt>Reference</dt><dd>設定など、参照用</dd></div>
        </dl>
        <ul class="projects">
          {
            selected.map((p) => (
              <li class="project" id={anchor(p.id)}>
                <div class="project-motif">{p.motif && <Motif name={p.motif} />}</div>
                <div class="project-main">
                  <h3>
                    {p.name}
                    <span class="status">{statusLabel[p.status]}</span>
                    <span class="release">{p.release}</span>
                  </h3>
                  <p>{p.summary}</p>
                  <dl class="facts">
                    <dt>問題</dt>
                    <dd>{p.problem}</dd>
                    <dt>アプローチ</dt>
                    <dd>{p.approach}</dd>
                    <dt>いま確認できること</dt>
                    <dd>{p.result}</dd>
                  </dl>
                  <ul class="inline-links">
                    {p.links.map((link) => (
                      <li>
                        <a href={link.url}>{link.label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ))
          }
        </ul>

        <h3 class="sub-head">Other projects</h3>
        <ul class="others">
          {
            others.map((p) => (
              <li id={anchor(p.id)}>
                <p class="other-name">
                  <strong>{p.name}</strong>
                  <span class="status">{statusLabel[p.status]}</span>
                  <span class="release">{p.release}</span>
                </p>
                <p class="other-summary">{p.summary}</p>
                <ul class="inline-links">
                  {p.links.map((link) => (
                    <li>
                      <a href={link.url}>{link.label}</a>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="experiments">
      <div class="section-head">
        <span class="num">03</span>
        <h2 id="experiments">Experiments</h2>
      </div>
      <div class="section-body">
        <p class="lede">完成した道具ではなく、技術的な問いを確かめるための実装。問いと、いまの到達点を書いています。</p>
        <ul class="projects">
          {
            experiments.map((p) => (
              <li class="project" id={anchor(p.id)}>
                <div class="project-motif">{p.motif && <Motif name={p.motif} />}</div>
                <div class="project-main">
                  <h3>
                    {p.name}
                    <span class="status">{statusLabel[p.status]}</span>
                    <span class="release">{p.release}</span>
                  </h3>
                  <p>{p.summary}</p>
                  <div class="experiment">
                    <span class="topic">Question</span>
                    <p>{p.question}</p>
                  </div>
                  <dl class="facts">
                    <dt>いまの到達点</dt>
                    <dd>{p.result}</dd>
                  </dl>
                  <ul class="inline-links">
                    {p.links.map((link) => (
                      <li>
                        <a href={link.url}>{link.label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="writing">
      <div class="section-head">
        <span class="num">04</span>
        <h2 id="writing">Writing</h2>
      </div>
      <div class="section-body">
        {
          writing.sources.map((source) => (
            <div class="writing-source">
              <h3 class="source-name">{source.name}</h3>
              <ul class="cards">
                {source.articles.map((article) => (
                  <li>
                    <a class="card" href={article.url}>
                      <span class="entry-meta">
                        <span class="topic">{article.topic}</span>
                        <time datetime={article.date}>{article.date}</time>
                      </span>
                      <span class="card-title" lang={source.lang}>
                        {article.title}
                      </span>
                      {article.project && (
                        <span class="card-project">→ {project(article.project).name}</span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
              <p class="more">
                <a href={source.profileUrl}>{source.moreLabel}</a>
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section" aria-labelledby="about">
      <div class="section-head">
        <span class="num">05</span>
        <h2 id="about">About</h2>
      </div>
      <div class="section-body about">
        {
          about.body.map((paragraph, i) => (
            <p class={i === 0 ? 'about-lead' : undefined}>{paragraph}</p>
          ))
        }
        <ul class="inline-links">
          {
            about.links.map((link) => (
              <li>
                <a href={link.url}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</Base>
